# Image Proxy Security
# Optional: Comma-separated list of allowed domains for image proxy
# If not set, all public domains are allowed (private networks are always blocked)
ALLOWED_DOMAINS=example.com,cdn.example.com

# Trusted proxy
# Optional: Set to 1/true ONLY when requests arrive through a reverse proxy
# you control. Without it, forwarded headers (X-Forwarded-For etc.) are
# ignored for rate limiting — direct clients could spoof them to rotate buckets
#TRUST_PROXY=1

# Caching
# Optional: Redis connection URL for distributed caching
# If not set, uses in-memory caching (suitable for development)
REDIS_URL=redis://localhost:6379

# Browser (Moli over CDP)
# Optional: CDP endpoint of the Moli browser server
# Defaults to http://127.0.0.1:9222 (the instance the Docker image supervises)
# For local development, start your own: moli serve --layout --resource
#BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222

# Browser user agents
# Optional: By default the browser kernel's own user agent is used, which
# stays consistent with its engine fingerprint. Set these to override.
#BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) ...
#BROWSER_USER_AGENT_MOBILE=Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) ...

# Browser concurrency
# Optional: Max concurrent pages per cluster worker. Defaults to 4
#BROWSER_MAX_CONCURRENCY=4

# Node cluster
# Optional: Number of cluster workers. Defaults to the CPU core count
#NITRO_CLUSTER_WORKERS=2

# Moli server flags (Docker image only)
# Optional: Extra flags passed to `moli serve` by the image entrypoint.
# The SSRF guard --block-private-networks is always enforced and cannot be removed
# Defaults to "--layout --resource"
#MOLI_FLAGS=--layout --resource
